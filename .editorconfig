root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csx,vb,vbx}]
indent_size = 4

[*.{json,yml,yaml,md,xml,props,targets}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.ps1]
indent_size = 2

[*.csproj]
indent_size = 2

[*.sln]
indent_style = space
indent_size = 2
