.heroes-demo-root {
  flex-grow: 1;
  flex-direction: row;
  background-color: rgb(14, 18, 26);
  padding: 16px;
}

.heroes-demo-left {
  flex-grow: 1;
  width: 58%;
  margin-right: 16px;
}

.heroes-demo-right {
  width: 40%;
  min-width: 320px;
  padding: 16px;
  background-color: rgb(22, 28, 38);
  border-left-width: 2px;
  border-left-color: rgb(61, 139, 253);
}

.heroes-title {
  font-size: 26px;
  color: rgb(232, 238, 244);
  letter-spacing: 2px;
  margin-bottom: 10px;
}

.heroes-filters {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.heroes-filters Button {
  margin-right: 8px;
  margin-bottom: 6px;
}

.heroes-hint {
  color: rgb(154, 171, 188);
  margin-bottom: 10px;
}

.heroes-scroll {
  flex-grow: 1;
}

.hero-cards {
  flex-direction: row;
  flex-wrap: wrap;
}

.hero-card {
  width: 200px;
  margin: 0 10px 10px 0;
  padding: 10px;
  background-color: rgb(28, 34, 46);
  border-left-width: 3px;
  border-left-color: rgb(90, 110, 140);
  align-items: flex-start;
}

.hero-card--selected {
  border-left-color: rgb(61, 139, 253);
  background-color: rgb(34, 44, 62);
}

.hero-card__name {
  font-size: 15px;
  color: rgb(232, 238, 244);
}

.hero-card__title {
  color: rgb(170, 186, 204);
  margin-top: 2px;
  white-space: normal;
}

.hero-card__rarity {
  color: rgb(212, 175, 55);
  margin-top: 4px;
}

.hero-card__faction {
  color: rgb(120, 170, 220);
  margin-top: 2px;
  font-size: 11px;
}

.hero-card__power {
  color: rgb(190, 150, 220);
  margin-top: 4px;
  white-space: normal;
}

.section-label {
  color: rgb(120, 150, 180);
  letter-spacing: 1px;
  margin-top: 8px;
  margin-bottom: 6px;
}

.detail-name {
  font-size: 24px;
  color: rgb(245, 248, 252);
}

.detail-title {
  color: rgb(180, 196, 214);
  margin-bottom: 8px;
}

.detail-meta {
  color: rgb(154, 171, 188);
  white-space: normal;
  margin-bottom: 10px;
}

.detail-power {
  color: rgb(210, 180, 255);
  white-space: normal;
  margin-bottom: 12px;
}

.power-panel {
  margin-top: 8px;
  margin-bottom: 12px;
  padding: 12px;
  background-color: rgb(18, 24, 34);
}

.power-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 8px;
}

.power-state {
  font-size: 16px;
  letter-spacing: 1px;
}

.power-state--ready {
  color: rgb(90, 210, 140);
}

.power-state--active {
  color: rgb(90, 170, 255);
}

.power-state--cooldown {
  color: rgb(230, 140, 80);
}

.power-timer {
  color: rgb(200, 210, 220);
}

.power-meter {
  height: 10px;
  background-color: rgb(40, 48, 60);
  margin-bottom: 10px;
  overflow: hidden;
}

.power-fill {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background-color: rgba(61, 139, 253, 0.75);
}

.activate-button {
  height: 36px;
}

.power-note {
  color: rgb(120, 136, 152);
  margin-top: 8px;
  white-space: normal;
  font-size: 11px;
}

.hero-preview-panel {
  margin-top: 8px;
  height: 280px;
  min-height: 240px;
  background-color: rgb(10, 13, 20);
  border-width: 1px;
  border-color: rgb(42, 53, 72);
  overflow: hidden;
}

.hero-preview-image {
  flex-grow: 1;
  width: 100%;
  height: 100%;
  min-height: 240px;
}
