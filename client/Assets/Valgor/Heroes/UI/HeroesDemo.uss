.heroes-demo-root {
  flex-grow: 1;
  flex-direction: row;
  background-color: rgb(14, 18, 26);
  padding: 12px;
  min-height: 100%;
}

.heroes-demo-left {
  flex-grow: 1;
  flex-shrink: 1;
  width: 56%;
  margin-right: 12px;
  min-width: 240px;
}

.heroes-demo-right {
  flex-grow: 1;
  flex-shrink: 1;
  width: 42%;
  min-width: 280px;
  max-width: 520px;
  padding: 12px;
  background-color: rgb(22, 28, 38);
  border-left-width: 2px;
  border-left-color: rgb(61, 139, 253);
  flex-direction: column;
}

.heroes-title {
  font-size: 24px;
  color: rgb(232, 238, 244);
  letter-spacing: 2px;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.heroes-filters {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.heroes-filters Button {
  margin-right: 8px;
  margin-bottom: 6px;
}

.heroes-hint {
  color: rgb(154, 171, 188);
  margin-bottom: 8px;
  flex-shrink: 0;
}

.heroes-scroll {
  flex-grow: 1;
  min-height: 120px;
}

.hero-cards {
  flex-direction: row;
  flex-wrap: wrap;
}

.hero-card {
  width: 168px;
  margin: 0 8px 8px 0;
  padding: 8px;
  background-color: rgb(28, 34, 46);
  border-left-width: 3px;
  border-left-color: rgb(90, 110, 140);
  align-items: flex-start;
}

.hero-card--selected {
  border-left-color: rgb(61, 139, 253);
  background-color: rgb(34, 44, 62);
}

.hero-card__portrait {
  width: 100%;
  height: 72px;
  margin-bottom: 6px;
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-color: rgb(70, 82, 104);
}

.hero-card__portrait-mark {
  font-size: 22px;
  color: rgb(230, 220, 190);
  -unity-font-style: bold;
}

.hero-card__name {
  font-size: 14px;
  color: rgb(232, 238, 244);
}

.hero-card__title {
  color: rgb(170, 186, 204);
  margin-top: 2px;
  white-space: normal;
  font-size: 11px;
}

.hero-card__rarity {
  color: rgb(212, 175, 55);
  margin-top: 4px;
  font-size: 11px;
}

.hero-card__stars {
  color: rgb(230, 190, 80);
  margin-top: 1px;
  font-size: 11px;
  letter-spacing: 1px;
}

.hero-card__faction {
  color: rgb(150, 185, 220);
  margin-top: 2px;
  font-size: 11px;
}

.hero-card__level {
  color: rgb(170, 180, 190);
  margin-top: 2px;
  font-size: 11px;
}

.hero-card__power {
  color: rgb(190, 150, 220);
  margin-top: 4px;
  white-space: normal;
}

.heroes-detail-scroll {
  flex-grow: 0;
  flex-shrink: 1;
  max-height: 34%;
  min-height: 120px;
  margin-bottom: 8px;
}

.heroes-detail-block {
  padding-right: 4px;
}

.section-label {
  color: rgb(120, 150, 180);
  letter-spacing: 1px;
  margin-top: 4px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.section-label--tight {
  margin-top: 0;
}

.detail-name {
  font-size: 22px;
  color: rgb(245, 248, 252);
}

.detail-title {
  color: rgb(180, 196, 214);
  margin-bottom: 6px;
}

.detail-meta {
  color: rgb(154, 171, 188);
  white-space: normal;
  margin-bottom: 8px;
  font-size: 12px;
}

.detail-power {
  color: rgb(210, 180, 255);
  white-space: normal;
  margin-bottom: 8px;
  font-size: 12px;
}

.power-panel {
  margin-top: 4px;
  margin-bottom: 4px;
  padding: 10px;
  background-color: rgb(18, 24, 34);
  flex-shrink: 0;
}

.power-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 8px;
}

.power-state {
  font-size: 16px;
  letter-spacing: 1px;
}

.power-state--ready {
  color: rgb(90, 210, 140);
}

.power-state--active {
  color: rgb(90, 170, 255);
}

.power-state--cooldown {
  color: rgb(230, 140, 80);
}

.power-timer {
  color: rgb(200, 210, 220);
}

.power-meter {
  height: 10px;
  background-color: rgb(40, 48, 60);
  margin-bottom: 10px;
  overflow: hidden;
}

.power-fill {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background-color: rgba(61, 139, 253, 0.75);
}

.activate-button {
  height: 44px;
  margin-bottom: 4px;
  flex-shrink: 0;
  background-color: rgb(48, 72, 38);
  border-color: rgb(120, 170, 70);
  color: rgb(230, 240, 220);
  font-size: 14px;
  -unity-font-style: bold;
}

.power-note {
  color: rgb(120, 136, 152);
  margin-top: 4px;
  white-space: normal;
  font-size: 11px;
  flex-shrink: 0;
}

.power-note--tight {
  margin-top: 0;
  margin-bottom: 6px;
}

.hero-preview-section {
  flex-grow: 1;
  flex-shrink: 0;
  min-height: 320px;
  flex-direction: column;
  padding-bottom: 4px;
}

.hero-preview-panel {
  flex-grow: 1;
  min-height: 280px;
  margin-top: 0;
  margin-bottom: 0;
  background-color: rgb(10, 13, 20);
  border-width: 1px;
  border-color: rgb(42, 53, 72);
  overflow: hidden;
  align-items: center;
  justify-content: center;
}

.hero-preview-image {
  flex-grow: 1;
  width: 100%;
  height: 100%;
  min-height: 260px;
  -unity-background-scale-mode: scale-to-fit;
}

/* Narrow / mobile-portrait: stack columns */
@media (max-width: 900px) {
  .heroes-demo-root {
    flex-direction: column;
    padding: 8px;
  }

  .heroes-demo-left {
    width: 100%;
    margin-right: 0;
    margin-bottom: 8px;
    max-height: 42%;
    min-width: 0;
  }

  .heroes-demo-right {
    width: 100%;
    max-width: none;
    min-width: 0;
    border-left-width: 0;
    border-top-width: 2px;
    border-top-color: rgb(61, 139, 253);
    flex-grow: 1;
  }

  .heroes-detail-scroll {
    max-height: 36%;
    min-height: 120px;
  }

  .hero-preview-section {
    min-height: 240px;
  }
}

@media (max-width: 600px) {
  .heroes-title {
    font-size: 20px;
  }

  .hero-card {
    width: 100%;
  }

  .heroes-detail-scroll {
    max-height: 32%;
  }

  .hero-preview-section {
    min-height: 220px;
  }
}
