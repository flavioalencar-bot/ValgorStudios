.root {
  flex-grow: 1;
  background-color: rgb(10, 12, 18);
  padding: 48px;
  align-items: center;
  justify-content: center;
}

.brand {
  color: rgb(219, 184, 97);
  font-size: 48px;
  letter-spacing: 10px;
  margin-bottom: 8px;
  -unity-font-style: bold;
}

.title {
  color: rgb(235, 224, 198);
  font-size: 18px;
  margin-bottom: 8px;
}

.session {
  color: rgb(158, 153, 133);
  font-size: 14px;
  margin-bottom: 28px;
}

.primary {
  background-color: rgb(20, 41, 71);
  color: rgb(235, 224, 198);
  font-size: 18px;
  padding: 14px 28px;
  border-width: 2px;
  border-color: rgb(184, 148, 71);
  border-radius: 0;
  min-width: 280px;
  min-height: 48px;
  margin-top: 10px;
}
