.root {
  flex-grow: 1;
  background-color: rgb(15, 20, 28);
  padding: 48px;
  align-items: flex-start;
  justify-content: center;
}

.brand {
  color: rgb(61, 139, 253);
  font-size: 14px;
  letter-spacing: 6px;
  margin-bottom: 12px;
}

.title {
  color: rgb(232, 238, 244);
  font-size: 42px;
  margin-bottom: 12px;
}

.session {
  color: rgb(154, 171, 188);
  font-size: 14px;
  margin-bottom: 28px;
}

.primary {
  background-color: rgb(61, 139, 253);
  color: rgb(255, 255, 255);
  font-size: 16px;
  padding: 12px 24px;
  border-width: 0;
  border-radius: 4px;
}
