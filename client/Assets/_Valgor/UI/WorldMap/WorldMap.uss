.root {
  flex-grow: 1;
  background-color: rgb(18, 26, 22);
  padding: 48px;
  justify-content: center;
}

.brand {
  color: rgb(90, 180, 120);
  font-size: 14px;
  letter-spacing: 6px;
  margin-bottom: 12px;
}

.title {
  color: rgb(232, 238, 244);
  font-size: 42px;
  margin-bottom: 8px;
}

.lede {
  color: rgb(154, 171, 188);
  margin-bottom: 28px;
}

.primary {
  background-color: rgb(90, 180, 120);
  color: rgb(12, 18, 14);
  font-size: 16px;
  padding: 12px 24px;
  border-width: 0;
  border-radius: 4px;
  max-width: 280px;
}
