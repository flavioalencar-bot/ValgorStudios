.loading-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(20, 23, 31);
}

.loading-title {
    margin-bottom: 28px;
    color: rgb(230, 236, 245);
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 6px;
}

.loading-progress {
    width: 360px;
    color: rgb(230, 236, 245);
}
